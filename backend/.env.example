# CivicAssist AI Backend Environment Configuration

# Django Settings
SECRET_KEY=civicassist-secret-key-development-replace-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database: Set USE_POSTGRES=True when your local or remote PostgreSQL is active
USE_POSTGRES=False
DB_NAME=civicassist_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optional: External AI APIs (Gemini / OpenAI API keys for production AI inference)
GEMINI_API_KEY=
